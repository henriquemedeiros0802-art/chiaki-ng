# Copie para .env e preencha. Nunca faça commit do .env.
ELEVENLABS_API_KEY=
DUB_TOKEN=troque-por-um-segredo-longo
DUB_MODEL=eleven_flash_v2_5
DUB_OUTPUT_FORMAT=pcm_24000
DUB_SPEED=1.0
# IDs de voz de reserva (usadas até a voz clonada ficar pronta)
DUB_VOICE_MALE=pNInz6obpgDQGcFmaJgB
DUB_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM
DUB_VOICE_NEUTRAL=pNInz6obpgDQGcFmaJgB
# Segundos de fala acumulados antes de clonar / reclonar
DUB_MIN_CLONE_S=12
DUB_RECLONE_S=40
# auto = Resemblyzer se instalado, senão embedder simples
DUB_EMBEDDER=auto
DUB_DATA=./data
